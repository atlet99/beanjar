"""Stand-in for beanjar-viewer in the manager tests: records its arguments, runs until SIGTERM."""

import signal
import sys
import time

print("fake viewer", *sys.argv[1:], flush=True)
signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
while True:
    time.sleep(3600)
