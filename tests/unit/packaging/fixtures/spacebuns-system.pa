# Bounded verbatim W24G 02.68.80.01 system.pa excerpts: lines 68-77 and 100-118.
load-module module-alsa-sink device=hw:0,6 mmap=0 sink_name=pcm_output tsched=0 fragments=2
#load-module module-alsa-source device=hw:0 mmap=0 source_name=pcm_input fragment_size=4096 tsched=0

# load native protocol
#load-module module-native-protocol-unix auth-group=jailusers
#load-module module-native-protocol-unix

# default pcm
set-default-sink pcm_output
set-default-source pcm_input
#only tts case use hw:0,7 others use hw:0,6
#mixing case cause noise because sources have different sample rate
load-module module-alsa-sink device=hw:0,7 mmap=0 sink_name=ptts fragment_size=4096 tsched=0 fragments=2
load-module module-null-sink sink_name=pndk
load-module module-null-sink sink_name=pnetflix
load-module module-null-sink sink_name=rtp rate=8000 channels=1 format=alaw
load-module module-null-sink sink_name=remote

load-module module-palm-policy

#load-module module-palm-a2dp-provider-sink sink_name=a2dp description="sink for data to be transmitted via a2dp"

load-module module-mic-capture

load-module module-null-source source_name=precord          description="source for general recording"
load-module module-null-source source_name=pvoipsource      description="source for voip applications"
#load-module module-null-source source_name=pvoicedialsource description="source for voice dial app"
