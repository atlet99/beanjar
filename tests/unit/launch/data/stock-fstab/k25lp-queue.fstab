# W25P 43.22.74.01: stock read-only and writable fstab entries.
/dev/mmcblk0p14 /mnt/lg/ciplus/cert squashfs ro 0 0
/dev/mmcblk0p30 /mnt/license squashfs ro 0 0
/dev/mmcblk0p33 /mnt/platform-plugins squashfs ro 0 0
/dev/mmcblk0p51 /mnt/lg/uhdcp ext4 rw,relatime,data=ordered,nosuid 0 0
/dev/mmcblk0p58 /mnt/lg/db8 ext4 rw,relatime,data=ordered,nosuid 0 0
/dev/mmcblk0p59 /mnt/lg/cmn_data ext4 rw,relatime,data=ordered,nosuid 0 0
/dev/mmcblk0p60 /mnt/lg/appstore ext4 rw,relatime,data=ordered,nosuid 0 0
