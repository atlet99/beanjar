# The normal layer's FirstUse marker on a state that already exists (usr/sbin/emulator-ran-firstuse):
# started with mount-readwrite.service, which mounts the state's partitions (on the firmware seen it
# comes after ls-hubd and bootd have started), and after it.
[Unit]
Description=Emulator: the normal layer's ran-firstuse marker
DefaultDependencies=no
After=mount-readwrite.service
Before=bootd.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/emulator-ran-firstuse
