#!/bin/sh
# SPDX-FileCopyrightText: Mariotaku <git@mariotaku.me> and the Beanjar contributors
# SPDX-License-Identifier: GPL-2.0-or-later
# The normal layer's FirstUse marker on a state that already exists. The layer's
# var/luna/preferences/ran-firstuse is what a blank state's /var is made from, but /var is the
# state's own partition, mounted over the layer: a VM first booted without the normal layer and
# given it later never sees the file, and bootd runs FirstUse. The marker is made here, before
# bootd looks for it. A state that has it is left as it is.
ROOT=${EMULATOR_ROOT:-}
DIR=$ROOT/var/luna/preferences
mkdir -p "$DIR" || exit 1
[ -e "$DIR/ran-firstuse" ] && exit 0
: > "$DIR/ran-firstuse" || exit 1
sync
logger -s "[normal] ran-firstuse was missing from this state: FirstUse skipped"
