# O24N keeps O24's boundaries; its boards are its own firmware's.
soc_layer_trees += ['--tree', meson.current_source_dir() / 'rootfs', '.']
# The OpenGL ES version of the chip's GPU (gl_es_version), at most which the gl layer's Mesa
# gives a context: W25O 33.31.68 and 44.00.67: libmali.so.0.46.0 prints "OpenGL ES 3.2"
gl_es_version = '3.2'
