# O22N keeps the initial LG GAL boundary; board options are firmware-derived.
soc_layer_trees += ['--tree', meson.current_source_dir() / 'rootfs', '.']
gst_elements = 'lx-o22n'          # W23O's AAC drc-mode default differs from W22O's
