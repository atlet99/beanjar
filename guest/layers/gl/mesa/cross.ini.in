# The cross file of the Mesa stack's inner Meson builds (libdrm, Wayland, Mesa), generated by
# guest/layers/gl/mesa/meson.build from the guest build's own compilers and flags.
[binaries]
c = @c@
cpp = @cpp@
ar = @ar@
strip = @strip@
readelf = @readelf@
objcopy = @objcopy@
nm = @nm@
pkg-config = '@PKG_CONFIG@'

[built-in options]
c_args = @c_args@
cpp_args = @cpp_args@
c_link_args = @c_link_args@
cpp_link_args = @cpp_link_args@

[host_machine]
system = '@SYSTEM@'
cpu_family = '@CPU_FAMILY@'
cpu = '@CPU@'
endian = '@ENDIAN@'
