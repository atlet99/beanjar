# W22H ombre-okapi: systemd250.5 retains the Qt daemon and ARIB mount boundary.
# The firmware's own Wayland is 1.20 (wayland's client, server, egl and cursor libraries), new enough
# for Mesa: the gl layer builds Mesa against that version and ships no Wayland library of its own
# (guest/layers/gl/mesa, firmware_wayland). ponytail inherits it; queue and spacebuns have 1.22.
firmware_wayland = '1.20.0'
