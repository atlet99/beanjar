--- /dev/null
+++ b/include/linux/devmem_window.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_DEVMEM_WINDOW_H
+#define _LINUX_DEVMEM_WINDOW_H
+
+#include <linux/list.h>
+#include <linux/types.h>
+
+/*
+ * A window of /dev/mem a driver backs: an mmap of /dev/mem that lies in [base, base + size) gets
+ * fresh pages, each filled by fill() with what the hardware at that physical address reads at the
+ * moment of the mmap, instead of a mapping of the physical address itself (where the machine has
+ * nothing). Both page-aligned; a mapping that crosses the window's edge is refused.
+ */
+struct devmem_window {
+	phys_addr_t base;
+	size_t size;
+	void (*fill)(const struct devmem_window *w, void *page, phys_addr_t pa);
+	struct list_head list;
+};
+
+int devmem_window_register(struct devmem_window *w);
+void devmem_window_unregister(struct devmem_window *w);
+
+#endif
