--- a/sound/virtio/virtio_pcm_ops.c
+++ b/sound/virtio/virtio_pcm_ops.c
@@ -135,6 +135,23 @@
 	return rc;
 }
 
+/* Called without the PCM stream lock, before runtime/message replacement.
+ * Disable new playback scheduling before waiting for the worker: STOP and
+ * completion use the same vss lock, so cancellation cannot race a self-requeue.
+ * The core's sync_stop is conditional on stop_operating; these lifecycle
+ * boundaries must also quiesce failed-start or pause work unconditionally.
+ */
+static void virtsnd_pcm_cancel_playback_work(struct virtio_pcm_substream *vss)
+{
+	if (vss->direction != SNDRV_PCM_STREAM_PLAYBACK)
+		return;
+
+	scoped_guard(spinlock_irqsave, &vss->lock) {
+		vss->xfer_enabled = false;
+	}
+	cancel_work_sync(&vss->elapsed_period);
+}
+
 /**
  * virtsnd_pcm_close() - Close the PCM substream.
  * @substream: Kernel ALSA substream.
