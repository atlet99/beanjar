virtio-snd: publish coalesced playback completions one period at a time

Two-period playback is advertised but a whole-buffer completion can leave the
ALSA core seeing the old modulo position. Counting raw completion bytes in
.pointer fixes indirect queue accounting but still loses the core's progress.
Keep raw, published and consumed counters distinct. Under the PCM stream lock,
publish one genuine completed period and process it in the core before exposing
the next. Bound each work invocation to one buffer and requeue pending progress.
Capture, advertised periods and the stock PulseAudio configuration are unchanged.

--- a/sound/virtio/virtio_pcm.h
+++ b/sound/virtio/virtio_pcm.h
@@ -56,7 +56,9 @@
 	spinlock_t lock;
 	size_t buffer_bytes;
 	size_t hw_ptr;
+	/* Playback completion, publication and pointer consumption counters. */
 	size_t hw_done;
+	size_t hw_published;
 	size_t hw_seen;
 	bool xfer_enabled;
 	bool xfer_xrun;
--- a/sound/virtio/virtio_pcm.c
+++ b/sound/virtio/virtio_pcm.c
@@ -319,8 +319,58 @@
 {
 	struct virtio_pcm_substream *vss =
 		container_of(work, struct virtio_pcm_substream, elapsed_period);
-
-	snd_pcm_period_elapsed(vss->substream);
+	struct snd_pcm_substream *substream = vss->substream;
+	unsigned int budget;
+
+	if (vss->direction != SNDRV_PCM_STREAM_PLAYBACK) {
+		snd_pcm_period_elapsed(substream);
+		return;
+	}
+
+	/* Lifecycle callbacks disable and cancel this work before replacing the
+	 * runtime/messages. Snapshot the allocated period budget under stream
+	 * serialization, and never loop or requeue a zero-budget work item.
+	 */
+	snd_pcm_stream_lock_irq(substream);
+	budget = vss->nmsgs;
+	snd_pcm_stream_unlock_irq(substream);
+	if (!budget)
+		return;
+
+	/* One buffer per invocation bounds work even if writers keep refilling.
+	 * Publish each genuine completed period separately while holding the
+	 * stream lock: app pointer queries cannot swallow a whole ring between
+	 * publication and the core's period processing. Never hold vss->lock
+	 * across the core call, whose pointer/ack takes queue then vss locks.
+	 */
+	while (budget--) {
+		unsigned long flags;
+		size_t period_bytes;
+		bool publish = false;
+
+		snd_pcm_stream_lock_irq(substream);
+		period_bytes = snd_pcm_lib_period_bytes(substream);
+		spin_lock_irqsave(&vss->lock, flags);
+		if (period_bytes && vss->xfer_enabled && snd_pcm_running(substream) &&
+		    vss->hw_done - vss->hw_published >= period_bytes) {
+			vss->hw_published += period_bytes;
+			publish = true;
+		}
+		spin_unlock_irqrestore(&vss->lock, flags);
+		if (publish)
+			snd_pcm_period_elapsed_under_stream_lock(substream);
+		snd_pcm_stream_unlock_irq(substream);
+		if (!publish)
+			return;
+	}
+
+	/* Completions racing with the last iteration cannot be lost. Queue
+	 * under the same lock used by STOP and the completion callback.
+	 */
+	scoped_guard(spinlock_irqsave, &vss->lock) {
+		if (vss->xfer_enabled && vss->hw_done != vss->hw_published)
+			schedule_work(&vss->elapsed_period);
+	}
 }
 
