virtio-snd: pcm_alias_device, a second ALSA PCM on the first playback stream

An LG SoC card has playback PCMs 0 to 9; LG's PulseAudio opens hw:0,6 (pcm_output, kernel
patch 0002's pcm_device_base). alsa-lib's name hints test device 0 for a card's basic hints
(sysdefault's device_output is defaults.pcm.dmix.device, 0), so a card whose only PCM is 6
lists no output at all, and Chromium's ALSA audio manager, which asks for any output hint
before it creates a stream, plays WebAudio nowhere (webOS 5 and 6).

With virtio_snd.pcm_alias_device=N the card gets an ALSA PCM device N with one playback
substream on the first playback stream. The two PCMs share the stream: one is open at a time,
the other's open fails with -EBUSY. The default, -1, keeps mainline behaviour.

--- a/sound/virtio/virtio_pcm.h
+++ b/sound/virtio/virtio_pcm.h
@@ -22,6 +22,7 @@
  * @direction: Stream data flow direction (SNDRV_PCM_STREAM_XXX).
  * @features: Stream VirtIO feature bit map (1 << VIRTIO_SND_PCM_F_XXX).
  * @substream: Kernel ALSA substream.
+ * @owner: The ALSA substream that has it open (one of two with pcm_alias_device), or NULL.
  * @pcm_indirect: Kernel indirect pcm structure.
  * @hw: Kernel ALSA substream hardware descriptor.
  * @elapsed_period: Kernel work to handle the elapsed period state.
@@ -48,6 +49,7 @@
 	u32 direction;
 	u32 features;
 	struct snd_pcm_substream *substream;
+	struct snd_pcm_substream *owner;
 	struct snd_pcm_indirect pcm_indirect;
 	struct snd_pcm_hardware hw;
 	struct work_struct elapsed_period;
--- a/sound/virtio/virtio_pcm.c
+++ b/sound/virtio/virtio_pcm.c
@@ -32,6 +32,11 @@
 module_param(pcm_device_base, uint, 0444);
 MODULE_PARM_DESC(pcm_device_base, "ALSA device number of the PCM with function node ID 0");
 
+static int pcm_alias_device = -1;
+module_param(pcm_alias_device, int, 0444);
+MODULE_PARM_DESC(pcm_alias_device, "ALSA device number of a second PCM on the first playback stream, "
+		 "one opener at a time (-1: none)");
+
 /* Map for converting VirtIO format to ALSA format. */
 static const snd_pcm_format_t g_v2a_format_map[] = {
 	[VIRTIO_SND_PCM_FMT_IMA_ADPCM] = SNDRV_PCM_FORMAT_IMA_ADPCM,
@@ -407,6 +412,47 @@
 	return rc;
 }
 
+/*
+ * virtsnd_pcm_build_alias() - With pcm_alias_device, a second ALSA PCM device with one playback
+ * substream on the first playback stream: a card whose firmware lists outputs by device 0 while
+ * its sound server opens another device finds both. The two share the stream, so one of them is
+ * open at a time and the other's open fails with -EBUSY (virtsnd_pcm_open).
+ */
+static int virtsnd_pcm_build_alias(struct virtio_snd *snd)
+{
+	struct virtio_pcm *vpcm;
+	struct snd_pcm *pcm;
+	int rc;
+
+	if (pcm_alias_device < 0)
+		return 0;
+
+	list_for_each_entry(vpcm, &snd->pcm_list, list)
+		if (vpcm->pcm && vpcm->streams[SNDRV_PCM_STREAM_PLAYBACK].nsubstreams)
+			break;
+	if (list_entry_is_head(vpcm, &snd->pcm_list, list))
+		return 0;
+
+	rc = snd_pcm_new(snd->card, VIRTIO_SND_CARD_DRIVER, pcm_alias_device, 1, 0, &pcm);
+	if (rc) {
+		dev_err(&snd->vdev->dev, "snd_pcm_new[alias %d] failed: %d\n",
+			pcm_alias_device, rc);
+		return rc;
+	}
+
+	pcm->info_flags = 0;
+	pcm->dev_class = SNDRV_PCM_CLASS_GENERIC;
+	pcm->dev_subclass = SNDRV_PCM_SUBCLASS_GENERIC_MIX;
+	snprintf(pcm->name, sizeof(pcm->name), VIRTIO_SND_PCM_NAME " %u", pcm->device);
+	pcm->private_data = vpcm;
+	pcm->nonatomic = true;
+	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_PLAYBACK,
+			&virtsnd_pcm_ops[SNDRV_PCM_STREAM_PLAYBACK]);
+	snd_pcm_set_managed_buffer_all(pcm, SNDRV_DMA_TYPE_VMALLOC, NULL, 0, 0);
+
+	return 0;
+}
+
 /**
  * virtsnd_pcm_build_devs() - Build ALSA PCM devices.
  * @snd: VirtIO sound device.
@@ -496,7 +542,7 @@
 					       0, 0);
 	}
 
-	return 0;
+	return virtsnd_pcm_build_alias(snd);
 }
 
 /**
--- a/sound/virtio/virtio_pcm_ops.c
+++ b/sound/virtio/virtio_pcm_ops.c
@@ -108,6 +108,12 @@
 	struct virtio_pcm *vpcm = snd_pcm_substream_chip(substream);
 	struct virtio_pcm_stream *vs = &vpcm->streams[substream->stream];
 	struct virtio_pcm_substream *vss = vs->substreams[substream->number];
+	int rc;
+
+	/* pcm_alias_device: two ALSA substreams on this stream, one opener at a time */
+	if (cmpxchg(&vss->owner, NULL, substream))
+		return -EBUSY;
+	vss->substream = substream;
 
 	substream->runtime->hw = vss->hw;
 	substream->private_data = vss;
@@ -123,7 +129,10 @@
 	 * an invalid state. Just in case, we do a check and try to return the
 	 * queue to its original state, if necessary.
 	 */
-	return virtsnd_pcm_sync_stop(substream);
+	rc = virtsnd_pcm_sync_stop(substream);
+	if (rc)
+		WRITE_ONCE(vss->owner, NULL);
+	return rc;
 }
 
 /**
@@ -135,6 +144,9 @@
  */
 static int virtsnd_pcm_close(struct snd_pcm_substream *substream)
 {
+	struct virtio_pcm_substream *vss = snd_pcm_substream_chip(substream);
+
+	WRITE_ONCE(vss->owner, NULL);
 	return 0;
 }
 
