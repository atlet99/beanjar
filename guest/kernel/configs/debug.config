# The debug kernel (meson option kernel_debug): webos_virt_defconfig with these over it, for
# the media pool's tests under the kernel's checkers (guest/kernel/modules/media-pool/tests).
# Built in a build directory of its own with its own publish_dir; booted with QEMU_EXTRA's -kernel
# and -initrd. KASAN generic (software tags) runs in TCG and KVM alike; it needs the memory.
# DEBUG_KERNEL gates lockdep, kmemleak and the list and object checks: without it they are dropped.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_FS=y
CONFIG_KUNIT=y
CONFIG_WEBOS_IVSHMEM_KUNIT_TEST=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=65536
CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN=y
CONFIG_DMA_API_DEBUG=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_OBJECTS=y
