# rtk.ko: Realtek's kernel drivers under its KADP userland (libkadaptor): the memory, RPC, scaler, capture, graphics and control units, and the TEE the
# firmware's OP-TEE client opens (tee.c, the device; tee-ta.c, the stand-in TAs). The internal
# micom's UCOM calls lgemu.ko's micom (lgemu-i2c.h; kbuild.sh gives modpost lgemu's Module.symvers).
obj-m := rtk.o
rtk-y := rtk-main.o rtk-memory.o rtk-rpc.o rtk-vsc.o rtk-vt.o rtk-graphics.o rtk-control.o tee.o tee-ta.o
ccflags-y := -I$(src)/../lgemu
